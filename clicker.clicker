class ClickerPlatform:
    def __init__(self, owner_channel_name="Mohammed_Khaled_Animation"):
        
        self.total_platform_earnings = 0.0
        
        # Initialize Core Systems
        self.user_manager = UserManagement()
        self.monetization = MonetizationSystem(self) 
        self.owner_panel = OwnerPanel(self) 
        
        # Initialize Hybrid Components
        self.youtube_guarantee = YouTubeGuarantee() 
        self.tiktok_guarantee = TikTokGuarantee() 
        self.ui_algo_manager = UILayoutAndAlgorithm(self)
        self.ai_assistant = ClickerAI()
        self.ad_manager = AdManager(self.monetization) 
        
        # Setup Owner (Mohammed)
        self.owner_user = self.user_manager.register_user(OWNER_NAME, "owner@clicker.com", 1995, phone_number="01275415699")
        if isinstance(self.owner_user, User):
            self.owner_user.user_id = OWNER_ID

