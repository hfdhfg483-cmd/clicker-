Import random
from datetime import datetime, timedelta
from enum import Enum
import time

# ====================================================================
# I. GLOBAL CONSTANTS AND ENUMS
# ====================================================================

OWNER_SECRET_CODE = "01275415699"
OWNER_NAME = "Mohammed"
OWNER_ID = 10001
MIN_FOLLOWERS_FOR_MONETIZATION = 500 
MAX_FAILED_ATTEMPTS = 3
OWNER_PLATFORM_SHARE = 0.80

class ContentType(Enum):
    LONG_VIDEO = "LongVideo" 
    SHORT_VIDEO = "ShortVideo"
    VR_360_VIDEO = "VR360Video"

# ====================================================================
# II. CORE DATA MODELS AND MANAGERS
# ====================================================================

class User:
    def __init__(self, user_id, username, email, dob_year, phone_number=None):
        self.user_id = user_id
        self.username = username
        self.email = email
        self.dob_year = dob_year 
        self.phone_number = phone_number
        self.achievement_points = 0

class Channel:
    def __init__(self, owner_user, name):
        self.owner_user = owner_user
        self.name = name
        self.subscribers_count = 0
        self.current_earnings = 0.0
        self.is_monetized = False
        self.is_owner_channel = (owner_user.username == OWNER_NAME) 
        
    def award_points(self, amount):
        self.owner_user.achievement_points += amount
        return f"{self.owner_user.username} awarded {amount} points."

class UserManagement:
    def __init__(self):
        self.registered_users = {} 
        
    def register_user(self, username, email, dob_year, phone_number=None):
        current_year = datetime.now().year
        if current_year - dob_year < 18:
            return "AGE_RESTRICTED"
        user_id = random.randint(10000, 99999)
        new_user = User(user_id, username, email, dob_year, phone_number)
        self.registered_users[user_id] = new_user
        return new_user

# ====================================================================
# III. HYBRID GUARANTEE CLASSES
# ====================================================================

class YouTubeGuarantee:
    def enforce_long_video_specs(self, video_duration_minutes):
        return video_duration_minutes >= 3

    def ensure_high_definition(self, resolution_code):
        return resolution_code >= 720
        
    def enforce_vr_specs(self, frame_rate):
        return frame_rate >= 60

class TikTokGuarantee:
    def enforce_short_video_specs(self, video_duration_seconds):
        return video_duration_seconds <= 60

    def calculate_quick_virality(self, engagement_rate):
        return engagement_rate * 100 > 80

